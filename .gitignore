# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Secrets and local environment
.env
.env.*
!.env.example
*.token
*.cookie

# Large/local data
data/raw/*
!data/raw/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/local.db
*.7z
*.gz
*.parquet

# Runtime temporary files
output/logs/*
!output/logs/.gitkeep
output/intermediate/*
!output/intermediate/.gitkeep
*.tmp
.DS_Store
Thumbs.db

# Judgment request/response payloads bundle raw HN text at bulk scale
# (a single request file can run into the megabytes) - same rationale as
# data/raw and data/local.db being excluded. run_state.json itself (small,
# structured) stays tracked for session-resume traceability.
output/runs/*/judgment/
