# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Secrets and local environment
.env
.env.*
*.token
*.cookie

# Large/local data
data/raw/*
!data/raw/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/local.db
*.7z
*.gz
*.parquet

# Runtime temporary files
output/logs/*
!output/logs/.gitkeep
output/intermediate/*
!output/intermediate/.gitkeep
*.tmp
.DS_Store
Thumbs.db
